    "/movies/{movie_id}": {
      "put": {
        "parameters": [
          { "name": "movie_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "202": { "description": "Accepted" }
        },
        "x-amazon-apigateway-integration": {
          "type": "aws",
          "httpMethod": "POST",
          "uri": "arn:aws:apigateway:us-east-1:sqs:path/${account_id}/${put_queue_name}",
          "credentials": "${api_gateway_role_arn}",
          "requestParameters": {
            "integration.request.header.Content-Type": "'application/x-www-form-urlencoded'"
          },
          "requestTemplates": {
            "application/json": "Action=SendMessage&MessageBody=$util.urlEncode($input.body)&MessageAttribute.1.Name=type&MessageAttribute.1.Value.DataType=String&MessageAttribute.1.Value.StringValue=movie&MessageAttribute.2.Name=movie_id&MessageAttribute.2.Value.DataType=String&MessageAttribute.2.Value.StringValue=$util.urlEncode($input.params('movie_id'))"
          },
          "passthroughBehavior": "never",
          "responses": {
            "default": { "statusCode": "202" }
          }
        }
      },
      "get": {
        "parameters": [
          { "name": "movie_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "OK" } },
        "x-amazon-apigateway-integration": {
          "type": "aws_proxy",
          "httpMethod": "POST",
          "uri": "arn:aws:apigateway:us-east-1:lambda:path/2015-03-31/functions/${get_function_arn}/invocations"
        }
      },
      "delete": {
        "parameters": [
          { "name": "movie_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "204": { "description": "Deleted" } },
        "x-amazon-apigateway-integration": {
          "type": "aws_proxy",
          "httpMethod": "POST",
          "uri": "arn:aws:apigateway:us-east-1:lambda:path/2015-03-31/functions/${delete_function_arn}/invocations"
        }
      }
    },
